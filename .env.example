# MySQL Laragon default; create the database once with database/schema.sql.
MYSQL_DSN=root:@tcp(127.0.0.1:3306)/temanaja?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
ADDR=:8080
APP_URL=http://localhost:8080

# Required to deliver verification codes to real email accounts. Without
# SMTP_HOST, the 4-digit code is printed in the Go server terminal for local development.
# Use SMTP port 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=temanaja@example.com
